---
import { Play } from '@lucide/astro';

interface Props {
  src: string;
  title: string;
}

const { src, title } = Astro.props;
const videoUrl = new URL(src);
let embedSrc = '';
let nativeVideo = false;

if (videoUrl.hostname === 'youtu.be') {
  embedSrc = `https://www.youtube-nocookie.com/embed/${videoUrl.pathname.slice(1)}`;
} else if (
  ['youtube.com', 'www.youtube.com', 'm.youtube.com'].includes(
    videoUrl.hostname,
  )
) {
  const videoId =
    videoUrl.searchParams.get('v') ??
    videoUrl.pathname.match(/\/(?:embed|shorts)\/([^/]+)/)?.[1];
  if (videoId) embedSrc = `https://www.youtube-nocookie.com/embed/${videoId}`;
} else if (
  videoUrl.hostname === 'vimeo.com' ||
  videoUrl.hostname === 'www.vimeo.com'
) {
  const videoId = videoUrl.pathname.split('/').filter(Boolean).at(-1);
  if (videoId && /^\d+$/.test(videoId))
    embedSrc = `https://player.vimeo.com/video/${videoId}?dnt=1`;
} else if (videoUrl.pathname.toLowerCase().endsWith('.mp4')) {
  embedSrc = videoUrl.href;
  nativeVideo = true;
}

if (!embedSrc)
  throw new Error(
    `Unsupported video URL for ${title}. Use YouTube, Vimeo, or an MP4 URL.`,
  );
---

<figure
  class="video-embed"
  data-video-embed
  data-video-src={embedSrc}
  data-video-title={title}
  data-video-native={nativeVideo}
>
  <div class="video-placeholder">
    <button
      class="video-load"
      type="button"
      data-video-load
      aria-label={`Load ${title}`}
    >
      <Play size={19} aria-hidden="true" />
      <span>Load video</span>
    </button>
    <a
      class="video-fallback"
      href={src}
      target="_blank"
      rel="noopener noreferrer"
    >
      Open video on its host
    </a>
  </div>
  <figcaption>{title}</figcaption>
</figure>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-video-embed]')
    .forEach((embed) => {
      const button = embed.querySelector('[data-video-load]');
      button?.addEventListener(
        'click',
        () => {
          const src = embed.dataset.videoSrc;
          const title = embed.dataset.videoTitle;
          if (!src || !title) return;

          let player;
          if (embed.dataset.videoNative === 'true') {
            player = document.createElement('video');
            player.src = src;
            player.controls = true;
            player.playsInline = true;
            player.preload = 'metadata';
          } else {
            player = document.createElement('iframe');
            player.src = src;
            player.title = title;
            player.loading = 'lazy';
            player.allowFullscreen = true;
            player.referrerPolicy = 'strict-origin-when-cross-origin';
          }

          embed.querySelector('.video-placeholder')?.replaceWith(player);
        },
        { once: true },
      );
    });
</script>
